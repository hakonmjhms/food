# --- App ---
APP_BASE_URL=http://localhost:8000

# --- Session ---
# Long random string used to sign the session cookie (admin login flag + CSRF token).
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY=change-me-to-a-long-random-string

# --- Database ---
# SQLite is used by default for zero-setup local development.
# In production, point this at a persistent PostgreSQL database, e.g.:
#   postgresql+psycopg2://user:password@host:5432/cake_voting
DATABASE_URL=sqlite:///./cake_voting.db

# --- Schedule ---
# Which weekday the vote runs on: 0=Sunday, 1=Monday, 2=Tuesday, 3=Wednesday,
# 4=Thursday, 5=Friday, 6=Saturday. Default is 4 (Thursday).
VOTE_WEEKDAY=4

# Vote schedule, in military time (HHMM), e.g. 1100 for 11:00.
# Must satisfy VOTE_OPEN_TIME < VOTE_CLOSE_TIME <= ACTUAL_VOTE_OPEN_TIME < ACTUAL_VOTE_CLOSE_TIME.
VOTE_OPEN_TIME=700
VOTE_CLOSE_TIME=1115
ACTUAL_VOTE_OPEN_TIME=1135
ACTUAL_VOTE_CLOSE_TIME=1700
